{
  "name": "markport-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "lint": "tsc --noEmit && eslint src tests e2e"
  },
  "dependencies": {
    "katex": "0.19.1",
    "mermaid": "^12.2.0",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
